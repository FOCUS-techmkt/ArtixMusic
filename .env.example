# ──────────────────────────────────────────────
# Supabase
# ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-side only, never expose

# ──────────────────────────────────────────────
# Cloudinary (image uploads)
# ──────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=presskit_unsigned  # unsigned upload preset

# ──────────────────────────────────────────────
# Anthropic (IA: recomendaciones + copy de email)
# ──────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-key

# ──────────────────────────────────────────────
# Resend (envío real de email marketing — opcional)
# Sin estas vars, el editor de email funciona (preview/export) pero
# el botón "Enviar" devuelve un aviso para configurarlas.
# ──────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_key
RESEND_FROM="Tu Artista <hola@tudominio.com>"      # remitente de un dominio verificado en Resend

# ──────────────────────────────────────────────
# App
# ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000         # change to https://presskit.pro in prod
